[Unit]
Description=Rick college football simulator (Flask/gunicorn)
After=network.target

[Service]
User=rick
Group=rick
WorkingDirectory=/opt/rick/app
EnvironmentFile=/opt/rick/env
Environment=RICK_DATA_DIR=/opt/rick/data
# one worker: the game lives in process memory
ExecStart=/opt/rick/venv/bin/gunicorn --workers 1 --threads 4 --timeout 120 --bind 0.0.0.0:80 app:app
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
